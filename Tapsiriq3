<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1 id="reqem">0</h1>
    <button id="artirma">Artir</button>
    <button id="azaltma">Azalt</button>
    <script src="test.js"></script>
</body>
</html>


var say = 0;
document.getElementById("artirma").onclick = function() {
    say++;
    document.getElementById("reqem").innerHTML = say;
}
document.getElementById("azaltma").onclick = function() {
    say--;
    document.getElementById("reqem").innerHTML = say;
}
